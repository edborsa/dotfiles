# PATH lives here, not in .zshenv: macOS's /etc/zprofile runs path_helper,
# which reorders anything set earlier.
eval "$(/opt/homebrew/bin/brew shellenv)"

path=("$HOME/.local/bin" /opt/homebrew/opt/libpq/bin $path /opt/homebrew/share/google-cloud-sdk/bin)
# gcloud components (gke-gcloud-auth-plugin, used by ~/.kube/config) live in the SDK bin, not /opt/homebrew/bin.
typeset -U path

# Shims so editors and GUI-launched processes find mise tools.
eval "$(mise activate zsh --shims)"

# Defaults nix-darwin used to set; kept for parity.
export EDITOR=nano
export PAGER="less -R"
