typeset -U path cdpath fpath manpath

HISTSIZE=50000
SAVEHIST=50000
HISTFILE="$HOME/.zsh_history"

autoload -U compinit && compinit
source "$HOME/.local/share/zsh/fzf-tab/fzf-tab.plugin.zsh"

source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
ZSH_AUTOSUGGEST_STRATEGY=(history)

eval "$(zoxide init zsh)"

if [[ $options[zle] = on ]]; then
  source <(fzf --zsh)
fi

setopt HIST_FCNTL_LOCK APPEND_HISTORY EXTENDED_HISTORY HIST_IGNORE_ALL_DUPS \
  HIST_IGNORE_DUPS HIST_IGNORE_SPACE SHARE_HISTORY NO_HIST_EXPIRE_DUPS_FIRST \
  NO_HIST_FIND_NO_DUPS NO_HIST_SAVE_NO_DUPS

export LS_COLORS="$(vivid generate tokyonight-moon)"

zmodload zsh/complist
zstyle ':completion:*' menu no
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always $realpath'
zstyle ':fzf-tab:complete:git-(add|diff|restore):*' fzf-preview 'git diff --color=always $word | delta'
zstyle ':fzf-tab:complete:git-log:*' fzf-preview 'git log --color=always $word'
zstyle ':fzf-tab:complete:git-show:*' fzf-preview 'case "$group" in "commit tag") git show --color=always $word ;; *) git show --color=always $word | delta ;; esac'
zstyle ':fzf-tab:complete:git-checkout:*' fzf-preview 'case "$group" in "modified file") git diff --color=always $word | delta ;; "recent commit object name") git show --color=always $word | delta ;; *) git log --color=always $word ;; esac'
zstyle ':fzf-tab:*' fzf-flags --bind=space:accept
zstyle ':fzf-tab:*' switch-group '<' '>'

bindkey -M menuselect '^I' menu-complete
bindkey -M menuselect '^[[Z' reverse-menu-complete

setopt AUTO_CD AUTO_MENU COMPLETE_IN_WORD INTERACTIVE_COMMENTS HIST_REDUCE_BLANKS

if [[ -o interactive && -z "${NO_TMUX:-}" && -z "${TMUX:-}" && -z "${SSH_CLIENT:-}" ]]; then
  ensure-tmux-is-running
fi

if [[ $TERM != "dumb" ]]; then
  eval "$(starship init zsh)"
fi

eval "$(mise activate zsh)"
eval "$(direnv hook zsh)"

alias -- cat=bat
alias -- grep=rg
alias -- la='eza -la'
alias -- ll='eza -l'
alias -- ls=eza
alias -- home='cd ~/Documents/00-09_System/02_Home && claude'

source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
ZSH_HIGHLIGHT_HIGHLIGHTERS=(main)
