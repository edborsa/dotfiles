# PATH lives here, not in .zshenv: macOS's /etc/zprofile runs path_helper,
# which reorders anything set earlier.
eval "$(/opt/homebrew/bin/brew shellenv)"

path=("$HOME/.local/bin" /opt/homebrew/opt/libpq/bin $path)
typeset -U path

# Shims so editors and GUI-launched processes find mise tools.
eval "$(mise activate zsh --shims)"
