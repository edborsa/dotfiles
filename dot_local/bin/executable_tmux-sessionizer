#!/usr/bin/env bash
set -euo pipefail

if [[ $# -eq 1 ]]; then
  selected="$1"
else
  search_roots=(
    "$HOME/projects"
    "$HOME/Projects"
    "$HOME/Documents"
  )

  existing_roots=()
  for root in "${search_roots[@]}"; do
    [[ -d "$root" ]] && existing_roots+=("$root")
  done

  if [[ ${#existing_roots[@]} -eq 0 ]]; then
    exit 0
  fi

  selected=$(find "${existing_roots[@]}" -mindepth 1 -maxdepth 4 -type d 2>/dev/null | sort -u | fzf)
fi

if [[ -z "${selected:-}" ]]; then
  exit 0
fi

if [[ ! -d "$selected" ]]; then
  echo "Selected path is not a directory: $selected" >&2
  exit 1
fi

sanitize_session_name() {
  printf '%s' "$1" | sed -e 's|[^A-Za-z0-9_-]|_|g'
}

session_exists() {
  tmux list-sessions -F '#S' 2>/dev/null | grep -Fxq "$1"
}

session_path() {
  tmux list-panes -t "=$1" -F '#{pane_current_path}' 2>/dev/null | head -n 1
}

base_name="$(basename "$selected")"
selected_name="$(sanitize_session_name "$base_name")"

if session_exists "$selected_name" && [[ "$(session_path "$selected_name")" != "$selected" ]]; then
  parent_name="$(basename "$(dirname "$selected")")"
  selected_name="$(sanitize_session_name "${parent_name}_${base_name}")"
fi

if ! session_exists "$selected_name"; then
  TMUX="" tmux new-session -ds "$selected_name" -c "$selected"
fi

if [[ -z "${TMUX:-}" ]]; then
  tmux attach-session -t "=$selected_name"
else
  tmux switch-client -t "=$selected_name"
fi
